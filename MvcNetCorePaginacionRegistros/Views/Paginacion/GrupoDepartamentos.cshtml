@model List<Departamento>
@{
    int numRegistros = (int)ViewData["NUMREGISTROS"];
    int numPagina = (int)ViewData["NUMPAGINA"];
}
<h1>Paginación Grupal Departamentos</h1>
<br />
<hr />
<br />
<div>
    @for (int i = 0; i <= numRegistros; i += 2)
    {
        <a asp-controller="Paginacion" asp-action="GrupoDepartamentos"
           asp-route-posicion="@numPagina"> Pagina @numPagina </a>
        numPagina++;
    }

</div>
<br />
<hr />
<br />
<table class="table table-bordered">
    <thead>
    <th>Id</th>
    <th>Nombre</th>
    <th>Localidad</th>
    </thead>
    <tbody>
        @foreach (Departamento dept in Model)
        {
            <tr>
                <td>@dept.IdDepartamento</td>
                <td>@dept.Nombre</td>
                <td>@dept.Localidad</td>
            </tr>
        }
    </tbody>
</tabl>
